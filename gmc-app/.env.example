# Copy to .env and fill in. Never commit .env.

# Secret key for hashing store hostnames (shopKey). Generate once, keep it forever:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SHOPKEY_SECRET=

# Public contact address shown on /privacy (e.g. a support inbox you control).
CONTACT_EMAIL=

# Database. Dev: file:dev.sqlite (relative to prisma/).
DATABASE_URL="file:dev.sqlite"

# Production on Render's free tier: hosted SQLite at Turso (free). When TURSO_DATABASE_URL is set,
# the app uses it instead of DATABASE_URL. Leave both empty in dev.
#   TURSO_DATABASE_URL=libsql://<db>-<org>.turso.io   (turso db show <db> --url)
#   TURSO_AUTH_TOKEN=...                              (turso db tokens create <db>)
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Public base URL of the deployed app, used in email links (no trailing slash), e.g. https://your-app.fly.dev
APP_PUBLIC_URL=

# Outcome email (scripts/send-outcome-emails.ts) via Resend: https://resend.com
RESEND_API_KEY=
# Sender, on a domain you verified in Resend, e.g. "Storefront Check <hello@yourdomain.com>"
MAIL_FROM=
# Required for real sends: CAN-SPAM needs a valid physical postal address (a PO box is fine)
MAIL_POSTAL_ADDRESS=
